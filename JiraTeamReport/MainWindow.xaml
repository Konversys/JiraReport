<Window x:Class="JiraTeamReport.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jira Team Report" Height="820" Width="1450" MinHeight="600" MinWidth="1000" Background="#F4F7FB" PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="16" CornerRadius="10" Background="White" BorderBrush="#DCE3EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Jira URL"/><TextBox x:Name="UrlBox" Height="32" Text="https://jira.company.local"/></StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0"><TextBlock Text="Логин / email"/><TextBox x:Name="LoginBox" Height="32"/></StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="6,0"><TextBlock Text="Пароль Jira"/><PasswordBox x:Name="PasswordBox" Height="32"/></StackPanel>
        <CheckBox x:Name="RememberCheck" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="Сохранять URL, логин и пароль при перезапуске" IsChecked="True" Margin="0,10,0,0" VerticalAlignment="Center" Unchecked="RememberCheck_Unchecked"/>
        <Button Grid.Row="0" Grid.Column="3" x:Name="ConnectButton" Content="Подключиться" Height="32" Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Bottom" Click="ConnectButton_Click" Background="#1769AA" Foreground="White"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Margin="0,12,0,12" Padding="14" CornerRadius="10" Background="White" BorderBrush="#DCE3EC" BorderThickness="1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Команда" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TeamBox" Width="280" Height="32" DisplayMemberPath="Name" IsEnabled="False"/>
        <TextBlock Text="С" VerticalAlignment="Center" Margin="20,0,8,0"/><DatePicker x:Name="FromDate" Width="145"/>
        <TextBlock Text="По" VerticalAlignment="Center" Margin="14,0,8,0"/><DatePicker x:Name="ToDate" Width="145"/>
        <Button x:Name="LoadButton" Content="Сформировать отчет" Padding="16,7" Margin="22,0,0,0" Click="LoadButton_Click" IsEnabled="False" Background="#1769AA" Foreground="White"/><Button Content="Показать пример" Padding="12,7" Margin="8,0,0,0" Click="DemoButton_Click"/>
        <TextBlock x:Name="StatusText" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#526174" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2" Background="White" BorderBrush="#DCE3EC">
      <TabItem Header="Отчет">
        <DockPanel><TextBox x:Name="CellPreviewBox" DockPanel.Dock="Top" Height="68" Margin="8" Padding="8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="13" BorderBrush="#DCE3EC" Background="#F8FAFC" ToolTip="Содержимое выделенной ячейки; можно выделить и скопировать текст"/><DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="1" SelectionUnit="Cell" SelectionMode="Single" SelectedCellsChanged="ReportGrid_SelectedCellsChanged" CurrentCellChanged="ReportGrid_CurrentCellChanged" PreviewKeyDown="ReportGrid_PreviewKeyDown" HeadersVisibility="Column" GridLinesVisibility="All" BorderBrush="#DCE3EC" Background="White" RowHeight="60" ColumnHeaderHeight="42" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsWeekend}" Value="True"><Setter Property="Background" Value="#FFF1F1"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
          <DataGrid.CellStyle>
            <Style TargetType="DataGridCell">
              <Setter Property="Foreground" Value="#243447"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE3EC"/>
              <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsWeekend, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Background" Value="#FFF1F1"/></DataTrigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFA"/><Setter Property="BorderBrush" Value="#4C91D1"/></Trigger></Style.Triggers>
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding DateLabel}" Width="120"/></DataGrid.Columns>
        </DataGrid></DockPanel>
      </TabItem>
      <TabItem Header="Логи API">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8"><Button Content="Очистить" Padding="12,5" Click="ClearLogsButton_Click"/><TextBlock Text="Запросы и ответы; пароль подключения не сохраняется в журнале." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#68778A"/></StackPanel>
          <ListBox x:Name="LogsList" ItemsSource="{Binding}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><TextBox Text="{Binding}" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" Margin="5,4" MaxHeight="180" VerticalScrollBarVisibility="Auto"/></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="3" Margin="4,10,0,0" Foreground="#68778A" Text="Выделите ячейку и нажмите Ctrl+C, чтобы скопировать текст. Задача и Epic Link отображаются ссылками; названия открываются в Jira."/>
  </Grid>
</Window>